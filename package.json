{
  "name": "devin-proxy",
  "version": "0.1.0",
  "description": "OpenAI-compatible local proxy over the Devin/Cascade backend — SWE-2/SWE-2.1 lanes through the guarded-retry devin-engine",
  "type": "module",
  "bin": {
    "devin-proxy": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "start": "bun src/cli.ts"
  },
  "keywords": [
    "devin",
    "cognition",
    "swe",
    "openai-compatible",
    "proxy"
  ],
  "license": "MIT",
  "author": {
    "name": "JoShMiQueL",
    "email": "joshmiquel.cs@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoShMiQueL/devin-proxy.git"
  },
  "dependencies": {
    "devin-core": "file:../devin-core",
    "devin-engine": "file:../devin-engine"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.7",
    "typescript": "^7.0.2"
  }
}
